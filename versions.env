# Pinned third-party versions. A workspace-bootstrap release always installs
# exactly these. Bump them in a commit, test, then cut a release.

# Oh My Zsh (no releases upstream; pinned to a master commit)
OMZ_REPO=https://github.com/ohmyzsh/ohmyzsh.git
OMZ_COMMIT=abfce729ab56543b976b08ef34a54b3dc57601a4   # master @ 2026-11-26

# --- Linux downloads -----------------------------------------------------
# Tools without an apt repository (or whose distribution package is a
# different program) are downloaded on Debian/Ubuntu at a pinned version
# and verified against these sha256 sums. On macOS they come from Homebrew.
# Sums taken from the upstream checksum files on 2026-11-26.

# mikefarah/yq (Debian's own "yq" package is a different, Python tool)
YQ_VERSION=4.54.3
YQ_SHA256_amd64=129534601871538efe0ba4c5e62a34fb1d5f469bcb975c4fddeb467d82974973
YQ_SHA256_arm64=89f69310b61b68d1245065a1241d1fc843f7a36cd6103ffd77ad987613bd1b67

TERRAGRUNT_VERSION=1.2.3
TERRAGRUNT_SHA256_amd64=f55f5943f7a5976b1a3675bbbe540cf81bbba3e415c18e980203f0fd664dae6b
TERRAGRUNT_SHA256_arm64=ac27de1383e298a91a4268b5f300852a9ef96bf2b07b4603b5784fd790b9dc05

FLUX_VERSION=2.10.1
FLUX_SHA256_amd64=967365ff84aabc97871827ff33713ef0c09f62dd83c18759e3a5e39adcea9285
FLUX_SHA256_arm64=da18ddb25c9614405d9e2f13ad014fd660bfcbe7218674cabf9325db73f811e2

# AWS CLI v2. AWS publishes GPG signatures, not checksums: these sums were
# taken after verifying each zip's signature with the AWS CLI Team key
# (fingerprint FB5D B77F D5C1 18B8 0511 ADA8 A631 0ACC 4672 475C).
AWSCLI_VERSION=2.42.4
AWSCLI_SHA256_amd64=8998885d7fc32370c50efc2e44746c34b222a03d70015113a5554f98be79165c
AWSCLI_SHA256_arm64=d0203a83caa162118c128ad16bc6c11835e998bd23763a3b195aeb323c78d010

# kubectl comes from pkgs.k8s.io, which has one apt repository per minor version.
KUBERNETES_MINOR=1.37
