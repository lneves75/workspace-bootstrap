" ~/.vimrc, managed by workspace-bootstrap.
" This file is a symlink into the repo, so do not edit it in place.
" Personal settings go in ~/.vimrc.local, which is sourced at the end.
" Intentionally minimal: built-in features only, no plugins.

set nocompatible
filetype plugin indent on
syntax on
set encoding=utf-8

" Interface
set number                      " line numbers
set ruler                       " cursor position in the status line
set showcmd                     " show partial commands
set showmatch                   " briefly jump to the matching bracket
set laststatus=2                " always show the status line
set wildmenu                    " menu for command-line completion
set wildmode=longest:full,full
set scrolloff=3                 " keep context lines above and below the cursor
set belloff=all
set backspace=indent,eol,start  " backspace over everything in insert mode
set hidden                      " switch buffers without saving first

" Search
set incsearch hlsearch          " highlight while typing and after searching
set ignorecase smartcase        " case-insensitive unless there is an uppercase letter
nnoremap <silent> <Esc><Esc> :nohlsearch<CR>

" Indentation: 2 spaces by default, language conventions below
set expandtab tabstop=2 shiftwidth=2 softtabstop=2
set autoindent
augroup wsb_indent
  autocmd!
  autocmd FileType go             setlocal noexpandtab tabstop=4 shiftwidth=4 softtabstop=0
  autocmd FileType python         setlocal expandtab tabstop=4 shiftwidth=4 softtabstop=4
  autocmd FileType make           setlocal noexpandtab tabstop=8 shiftwidth=8 softtabstop=0
  autocmd FileType gitcommit      setlocal textwidth=72 spell
augroup END

" Show tabs and trailing spaces
set list listchars=tab:»\ ,trail:·,nbsp:␣

" Keep swap, backup and undo files out of the working directory
for s:dir in ['swap', 'backup', 'undo']
  if !isdirectory(expand('~/.vim/' . s:dir))
    call mkdir(expand('~/.vim/' . s:dir), 'p', 0700)
  endif
endfor
set directory=~/.vim/swap//
set backupdir=~/.vim/backup//
set undodir=~/.vim/undo//
set undofile

" Return to the last cursor position when reopening a file
augroup wsb_lastpos
  autocmd!
  autocmd BufReadPost * if line("'\"") >= 1 && line("'\"") <= line("$") && &ft !~# 'commit' | exe "normal! g`\"" | endif
augroup END

if filereadable(expand('~/.vimrc.local'))
  source ~/.vimrc.local
endif
